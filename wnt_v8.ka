%init:  10 Axin()
%init:  10 APC()
%init:  10 bCat()
%init:  10 LRP()
%init:  10 Wnt()
%init:  10 Fzd()
%init:  10 Dvl()
%init:  10 CK1e()
%init:  10 CK1a()
%init:  10 GSK3b()

//----------------------------------------------------------------------------------------

// >>>>> influx of bCat
// NOTE: A bit confused about this
. -> bCat() @ 1.0

// >>>>> degradation of bCat from APC only

bCat(S33{p}, S37{p}, arm[rpt1.APC]) -> . @ 1.0
bCat(S33{p}, S37{p}, arm[rpt3.APC]) -> . @ 1.0
bCat(S33{p}, S37{p}, arm[rpt4.APC]) -> . @ 1.0
bCat(S33{p}, S37{p}, arm[rpt5.APC]) -> . @ 1.0
bCat(S33{p}, S37{p}, arm[rpt6.APC]) -> . @ 1.0
bCat(S33{p}, S37{p}, arm[rpt7.APC]) -> . @ 1.0

// >>>>> phosphorylation of APC's 20aa repeats rpt1 to rpt7

APC(rpt1[.]{u}, pr{p}), CK1e() -> APC(rpt1[.]{p}, pr{p}), CK1e() @ 1.0
APC(rpt3[.]{u}, pr{p}), CK1e() -> APC(rpt3[.]{p}, pr{p}), CK1e() @ 1.0
APC(rpt4[.]{u}, pr{p}), CK1e() -> APC(rpt4[.]{p}, pr{p}), CK1e() @ 1.0
APC(rpt5[.]{u}, pr{p}), CK1e() -> APC(rpt5[.]{p}, pr{p}), CK1e() @ 1.0
APC(rpt6[.]{u}, pr{p}), CK1e() -> APC(rpt6[.]{p}, pr{p}), CK1e() @ 1.0
APC(rpt7[.]{u}, pr{p}), CK1e() -> APC(rpt7[.]{p}, pr{p}), CK1e() @ 1.0

//  >>>>> APC-bCat binding reactions
//
// For the p'd rpt sites, binding constants are augmented by a factor of 10 and 
// dissociation constants are reduced by a factor of 10 compared to the unphosphorylated case.

APC(rpt1[.]), bCat(arm[.]) -> APC(rpt1[1]), bCat(arm[1]) @ 1.0
APC(rpt3[.]), bCat(arm[.]) -> APC(rpt3[1]), bCat(arm[1]) @ 1.0
APC(rpt4[.]), bCat(arm[.]) -> APC(rpt4[1]), bCat(arm[1]) @ 1.0
APC(rpt5[.]), bCat(arm[.]) -> APC(rpt5[1]), bCat(arm[1]) @ 1.0
APC(rpt6[.]), bCat(arm[.]) -> APC(rpt6[1]), bCat(arm[1]) @ 1.0
APC(rpt7[.]), bCat(arm[.]) -> APC(rpt7[1]), bCat(arm[1]) @ 1.0

//  >>>>> APC-bCat dissociation reactions

APC(rpt1[1]{u}), bCat(arm[1]) -> APC(rpt1[.]{u}), bCat(arm[.]) @ 1.0
APC(rpt3[1]{u}), bCat(arm[1]) -> APC(rpt3[.]{u}), bCat(arm[.]) @ 1.0
APC(rpt4[1]{u}), bCat(arm[1]) -> APC(rpt4[.]{u}), bCat(arm[.]) @ 1.0
APC(rpt5[1]{u}), bCat(arm[1]) -> APC(rpt5[.]{u}), bCat(arm[.]) @ 1.0
APC(rpt6[1]{u}), bCat(arm[1]) -> APC(rpt6[.]{u}), bCat(arm[.]) @ 1.0
APC(rpt7[1]{u}), bCat(arm[1]) -> APC(rpt7[.]{u}), bCat(arm[.]) @ 1.0

APC(rpt1[1]{p}), bCat(arm[1]) -> APC(rpt1[.]{p}), bCat(arm[.]) @ 1.0
APC(rpt3[1]{p}), bCat(arm[1]) -> APC(rpt3[.]{p}), bCat(arm[.]) @ 1.0
APC(rpt4[1]{p}), bCat(arm[1]) -> APC(rpt4[.]{p}), bCat(arm[.]) @ 1.0
APC(rpt5[1]{p}), bCat(arm[1]) -> APC(rpt5[.]{p}), bCat(arm[.]) @ 1.0
APC(rpt6[1]{p}), bCat(arm[1]) -> APC(rpt6[.]{p}), bCat(arm[.]) @ 1.0
APC(rpt7[1]{p}), bCat(arm[1]) -> APC(rpt7[.]{p}), bCat(arm[.]) @ 1.0

// // >>>>> APC captures bCat from Axin
//
// (This is dependent of the degron state at bCat, and requires the rpt site of APC to be phosphorylated.)

APC(rpt1[.]{p}), bCat(S33{p}, S37{p}, arm[1]), Axin(cbd[1]) -> APC(rpt1[1]{p}), bCat(S33{p}, S37{p}, arm[1]), Axin(cbd[.]) @ 1.0
APC(rpt3[.]{p}), bCat(S33{p}, S37{p}, arm[1]), Axin(cbd[1]) -> APC(rpt3[1]{p}), bCat(S33{p}, S37{p}, arm[1]), Axin(cbd[.]) @ 1.0
APC(rpt4[.]{p}), bCat(S33{p}, S37{p}, arm[1]), Axin(cbd[1]) -> APC(rpt4[1]{p}), bCat(S33{p}, S37{p}, arm[1]), Axin(cbd[.]) @ 1.0
APC(rpt5[.]{p}), bCat(S33{p}, S37{p}, arm[1]), Axin(cbd[1]) -> APC(rpt5[1]{p}), bCat(S33{p}, S37{p}, arm[1]), Axin(cbd[.]) @ 1.0
APC(rpt6[.]{p}), bCat(S33{p}, S37{p}, arm[1]), Axin(cbd[1]) -> APC(rpt6[1]{p}), bCat(S33{p}, S37{p}, arm[1]), Axin(cbd[.]) @ 1.0
APC(rpt7[.]{p}), bCat(S33{p}, S37{p}, arm[1]), Axin(cbd[1]) -> APC(rpt7[1]{p}), bCat(S33{p}, S37{p}, arm[1]), Axin(cbd[.]) @ 1.0

// >>>>> Simplified phosphorylation of Axin by GSK3
// TS{p} by GSK3b increases affinity of Axin-bCat
// Sx{p} by CK1a increases affinity of Axin-GSK3 (and stabilizes against degradation by tankyrase)

Axin(TSx{u}), GSK3b(dom[gsk.Axin], lrp[.]) -> Axin(TSx{p}), GSK3b(dom[gsk.Axin], lrp[.]) @ 1.0
Axin(Sx{u}), CK1a(dom[kb.Axin]) -> Axin(Sx{p}), CK1a(dom[kb.Axin]) @ 1.0

// >>>>> Simplified priming of APC by GSK3

GSK3b(dom[gsk.Axin], lrp[.]), APC(pr{u}) -> GSK3b(dom[gsk.Axin], lrp[.]), APC(pr{p}) @ 1.0

// >>>>> bCat degron phosphorylation

bCat(S45{u}), CK1a(dom[kb.Axin]) -> bCat(S45{p}), CK1a(dom[kb.Axin]) @ 1.0
bCat(T41{u}, S45{p}), GSK3b(dom[gsk.Axin], lrp[.]) -> bCat(T41{p}, S45{p}), GSK3b(dom[gsk.Axin], lrp[.]) @ 1.0
bCat(S37{u}, T41{p}), GSK3b(dom[gsk.Axin], lrp[.]) -> bCat(S37{p}, T41{p}), GSK3b(dom[gsk.Axin], lrp[.]) @ 1.0
bCat(S33{u}, T41{p}), GSK3b(dom[gsk.Axin], lrp[.]) -> bCat(S33{p}, T41{p}), GSK3b(dom[gsk.Axin], lrp[.]) @ 1.0

// >>>>> APC dimerization

APC(dim[.]), APC(dim[.]) -> APC(dim[1]), APC(dim[1])     @ 1.0
APC(dim[1]), APC(dim[1]) -> APC(dim[.]), APC(dim[.])     @ 1.0

// >>>>> Axin polymerization

Axin(dix_t[.]), Axin(dix_h[.]) -> Axin(dix_t[1]), Axin(dix_h[1]) @ 1.0
Axin(dix_t[1]), Axin(dix_h[1]) -> Axin(dix_t[.]), Axin(dix_h[.]) @ 1.0

// >>>>> Axin binding to APC is exclusive of Axin binding to Dvl

APC(samp1[.]), Axin(rgs[.], dix_t[.], dix_h[.]) -> APC(samp1[1]), Axin(rgs[1], dix_t[.], dix_h[.]) @ 1.0
APC(samp2[.]), Axin(rgs[.], dix_t[.], dix_h[.]) -> APC(samp2[1]), Axin(rgs[1], dix_t[.], dix_h[.]) @ 1.0
APC(samp3[.]), Axin(rgs[.], dix_t[.], dix_h[.]) -> APC(samp3[1]), Axin(rgs[1], dix_t[.], dix_h[.]) @ 1.0

APC(samp1[.]), Axin(rgs[.], dix_t[dix_h.Axin], dix_h[.]) -> APC(samp1[1]), Axin(rgs[1], dix_t[dix_h.Axin], dix_h[.]) @ 1.0
APC(samp2[.]), Axin(rgs[.], dix_t[dix_h.Axin], dix_h[.]) -> APC(samp2[1]), Axin(rgs[1], dix_t[dix_h.Axin], dix_h[.]) @ 1.0
APC(samp3[.]), Axin(rgs[.], dix_t[dix_h.Axin], dix_h[.]) -> APC(samp3[1]), Axin(rgs[1], dix_t[dix_h.Axin], dix_h[.]) @ 1.0

APC(samp1[.]), Axin(rgs[.], dix_t[.], dix_h[dix_t.Axin]) -> APC(samp1[1]), Axin(rgs[1], dix_t[.], dix_h[dix_t.Axin]) @ 1.0
APC(samp2[.]), Axin(rgs[.], dix_t[.], dix_h[dix_t.Axin]) -> APC(samp2[1]), Axin(rgs[1], dix_t[.], dix_h[dix_t.Axin]) @ 1.0
APC(samp3[.]), Axin(rgs[.], dix_t[.], dix_h[dix_t.Axin]) -> APC(samp3[1]), Axin(rgs[1], dix_t[.], dix_h[dix_t.Axin]) @ 1.0

APC(samp1[.]), Axin(rgs[.], dix_t[dix_h.Axin], dix_h[dix_t.Axin]) -> APC(samp1[1]), Axin(rgs[1], dix_t[dix_h.Axin], dix_h[dix_t.Axin]) @ 1.0
APC(samp2[.]), Axin(rgs[.], dix_t[dix_h.Axin], dix_h[dix_t.Axin]) -> APC(samp2[1]), Axin(rgs[1], dix_t[dix_h.Axin], dix_h[dix_t.Axin]) @ 1.0
APC(samp3[.]), Axin(rgs[.], dix_t[dix_h.Axin], dix_h[dix_t.Axin]) -> APC(samp3[1]), Axin(rgs[1], dix_t[dix_h.Axin], dix_h[dix_t.Axin]) @ 1.0

APC(samp1[1]), Axin(rgs[1]) -> APC(samp1[.]), Axin(rgs[.]) @ 1.0
APC(samp2[1]), Axin(rgs[1]) -> APC(samp2[.]), Axin(rgs[.]) @ 1.0
APC(samp3[1]), Axin(rgs[1]) -> APC(samp3[.]), Axin(rgs[.]) @ 1.0

// >>>>> Axin binds bCat

Axin(cbd[.], TSx{u}), bCat(arm[.]) -> Axin(cbd[1], TSx{u}), bCat(arm[1]) @ 1.0
Axin(cbd[.], TSx{p}), bCat(arm[.]) -> Axin(cbd[1], TSx{p}), bCat(arm[1]) @ 1.0

Axin(cbd[1], TSx{u}), bCat(arm[1]) -> Axin(cbd[.], TSx{u}), bCat(arm[.]) @ 1.0
Axin(cbd[1], TSx{p}), bCat(arm[1]) -> Axin(cbd[.], TSx{p}), bCat(arm[.]) @ 1.0

// >>>>> (un)binding of Axin to CK1a, CK1e and GSK3b

Axin(kb[.]), CK1e(dom[.]) -> Axin(kb[1]), CK1e(dom[1]) @ 1.0
Axin(kb[1]), CK1e(dom[1]) -> Axin(kb[.]), CK1e(dom[.]) @ 1.0
Axin(kb[.]), CK1a(dom[.]) -> Axin(kb[1]), CK1a(dom[1]) @ 1.0
Axin(kb[1]), CK1a(dom[1]) -> Axin(kb[.]), CK1a(dom[.]) @ 1.0
Axin(gsk[.]), GSK3b(dom[.]) -> Axin(gsk[1]), GSK3b(dom[1]) @ 1.0
Axin(gsk[1], Sx{u}), GSK3b(dom[1]) -> Axin(gsk[.], Sx{u}), GSK3b(dom[.]) @ 1.0
Axin(gsk[1], Sx{p}), GSK3b(dom[1]) -> Axin(gsk[.], Sx{p}), GSK3b(dom[.]) @ 1.0

// >>>>> Dvl self-interactions

Dvl(dix_h[.]), Dvl(dix_t[.]) -> Dvl(dix_h[1]), Dvl(dix_t[1]) @ 1.0
Dvl(dix_h[1]), Dvl(dix_t[1]) -> Dvl(dix_h[.]), Dvl(dix_t[.]) @ 1.0

// >>>>> Axin binding to Dvl is exclusive of Axin binding to APC
// depends on p'lation state of site TSx of Dvl

Axin(rgs[.], dix_t[.]), Dvl(dix_h[.], TSx{u}) -> Axin(rgs[.], dix_t[1]), Dvl(dix_h[1], TSx{u}) @ 1.0
Axin(rgs[.], dix_h[.]), Dvl(dix_t[.], TSx{u}) -> Axin(rgs[.], dix_h[1]), Dvl(dix_t[1], TSx{u}) @ 1.0
Axin(rgs[.], dix_t[.]), Dvl(dix_h[.], TSx{p}) -> Axin(rgs[.], dix_t[1]), Dvl(dix_h[1], TSx{p}) @ 1.0
Axin(rgs[.], dix_h[.]), Dvl(dix_t[.], TSx{p}) -> Axin(rgs[.], dix_h[1]), Dvl(dix_t[1], TSx{p}) @ 1.0

Axin(rgs[.], dix_t[1]), Dvl(dix_h[1], TSx{u}) -> Axin(rgs[.], dix_t[.]), Dvl(dix_h[.], TSx{u}) @ 1.0
Axin(rgs[.], dix_h[1]), Dvl(dix_t[1], TSx{u}) -> Axin(rgs[.], dix_h[.]), Dvl(dix_t[.], TSx{u}) @ 1.0
Axin(rgs[.], dix_t[1]), Dvl(dix_h[1], TSx{p}) -> Axin(rgs[.], dix_t[.]), Dvl(dix_h[.], TSx{p}) @ 1.0
Axin(rgs[.], dix_h[1]), Dvl(dix_t[1], TSx{p}) -> Axin(rgs[.], dix_h[.]), Dvl(dix_t[.], TSx{p}) @ 1.0

// >>>>> phosphorylation of Dvl by CK1e

// mechanism 1
CK1e(dom[kb.Axin]), Dvl(dep[dvl.Fzd], TSx{u}) -> CK1e(dom[kb.Axin]), Dvl(dep[dvl.Fzd], TSx{p}) @ 1.0

// mechanism 2 (MM-like)
CK1e(dom[.]), Dvl(dep[dvl.Fzd], TSx{u}, ck1[.]) -> CK1e(dom[1]), Dvl(dep[dvl.Fzd], TSx{u}, ck1[1]) @ 1.0
CK1e(dom[1]), Dvl(ck1[1]) -> CK1e(dom[.]), Dvl(ck1[.]) @ 1.0
CK1e(dom[1]), Dvl(TSx{u}, ck1[1]) -> CK1e(dom[1]), Dvl(TSx{p}, ck1[1]) @ 1.0

// >>>>> (un)binding of Fzd to Dvl
// requires Fzd to be bound to Wnt

Fzd(wnt[fzd.Wnt], dvl[.]), Dvl(dep[.]) -> Fzd(wnt[fzd.Wnt], dvl[1]), Dvl(dep[1]) @ 1.0
Fzd(wnt[fzd.Wnt], dvl[1]), Dvl(dep[1]) -> Fzd(wnt[fzd.Wnt], dvl[.]), Dvl(dep[.]) @ 1.0

// >>>>> dimerization of Fzd

Fzd(dim[.]), Fzd(dim[.]) -> Fzd(dim[1]), Fzd(dim[1]) @ 1.0
Fzd(dim[1]), Fzd(dim[1]) -> Fzd(dim[.]), Fzd(dim[.]) @ 1.0

// >>>>> dimerization of LRP

LRP(dim[.]), LRP(dim[.]) -> LRP(dim[1]), LRP(dim[1]) @ 1.0
LRP(dim[1]), LRP(dim[1]) -> LRP(dim[.]), LRP(dim[.]) @ 1.0

// >>>>> (un)binding interactions of Wnt with Fzd and LRP

Wnt(fzd[.]), Fzd(wnt[.]) -> Wnt(fzd[1]), Fzd(wnt[1]) @ 1.0
Wnt(fzd[1]), Fzd(wnt[1]) -> Wnt(fzd[.]), Fzd(wnt[.]) @ 1.0
Wnt(lrp[.]), LRP(wnt[.]) -> Wnt(lrp[1]), LRP(wnt[1]) @ 1.0
Wnt(lrp[1]), LRP(wnt[1]) -> Wnt(lrp[.]), LRP(wnt[.]) @ 1.0

// an alternative would be to have Wnt bind irreversibly in bimolecular fashion
// Wnt(fzd[.]), Fzd(wnt[.]) -> Wnt(fzd[1]), Fzd(wnt[1]) @ 1.0
// Wnt(lrp[.]), LRP(wnt[.]) -> Wnt(lrp[1]), LRP(wnt[1]) @ 1.0

// >>>>> GSK3b phosphorylates LRP intramolecularly

GSK3b(dom[gsk.Axin], lrp[.]), LRP(TSx{u}[.]) -> GSK3b(dom[gsk.Axin], lrp[.]), LRP(TSx{p}[.]) @ 1.0

// >>>>> LRP binds and inactivates GSK3b

LRP(TSx{p}[.]), GSK3b(lrp[.]) -> LRP(TSx{p}[1]), GSK3b(lrp[1]) @ 1.0
LRP(TSx[1]), GSK3b(lrp[1]) -> LRP(TSx[.]), GSK3b(lrp[.]) @ 1.0

// >>>>> generic dephosphorylations

APC(rpt1[.]{p}) -> APC(rpt1[.]{u}) @ 1.0
APC(rpt3[.]{p}) -> APC(rpt3[.]{u}) @ 1.0
APC(rpt4[.]{p}) -> APC(rpt4[.]{u}) @ 1.0
APC(rpt5[.]{p}) -> APC(rpt5[.]{u}) @ 1.0
APC(rpt6[.]{p}) -> APC(rpt6[.]{u}) @ 1.0
APC(rpt7[.]{p}) -> APC(rpt7[.]{u}) @ 1.0
APC(pr{p}) -> APC(pr{u}) @ 1.0

Axin(TSx{p}) -> Axin(TSx{u}) @ 1.0
Axin(Sx{p}) -> Axin(Sx{u}) @ 1.0

Dvl(TSx{p}) -> Dvl(TSx{u}) @ 1.0
LRP(TSx{p}[.]) -> LRP(TSx{u}[.]) @ 1.0

bCat(S45{p}, arm[1]), Axin(cbd[1]) -> bCat(S45{u}, arm[1]), Axin(cbd[1]) @ 1.0
bCat(T41{p}, arm[1]), Axin(cbd[1]) -> bCat(T41{u}, arm[1]), Axin(cbd[1]) @ 1.0
bCat(S37{p}, arm[1]), Axin(cbd[1]) -> bCat(S37{u}, arm[1]), Axin(cbd[1]) @ 1.0
bCat(S33{p}, arm[1]), Axin(cbd[1]) -> bCat(S33{u}, arm[1]), Axin(cbd[1]) @ 1.0

bCat(S45{p}, arm[.]) -> bCat(S45{u}, arm[.]) @ 1.0
bCat(T41{p}, arm[.]) -> bCat(T41{u}, arm[.]) @ 1.0
bCat(S37{p}, arm[.]) -> bCat(S37{u}, arm[.]) @ 1.0
bCat(S33{p}, arm[.]) -> bCat(S33{u}, arm[.]) @ 1.0

// >>>>> Axin turn-over

Axin(), . -> ., Axin() @ 1.0


